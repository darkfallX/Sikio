# Public site URL for sitemap.xml & OpenGraph metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# QDay Aevum Testnet (Chain ID 44005)
NEXT_PUBLIC_AEVUM_RPC_URL=https://rpc-test.qday.info
NEXT_PUBLIC_AEVUM_EXPLORER_URL=https://explorer-test.qday.info
NEXT_PUBLIC_TUSD8_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483

# Deployed ReviewEscrow contract on QDay Aevum Testnet (Chain 44005)
NEXT_PUBLIC_REVIEW_ESCROW_ADDRESS=0x36Cf1caB839bf01306E647C56B2e44e7d4a35E6b

# Optional: real speech recognition with per-word confidences (Deepgram nova-3).
# Without it, the bundled clips use a prepared transcript that is labelled as such.
DEEPGRAM_API_KEY=

# Optional: enables live Whisper transcription proxy on /api/transcribe
OPENAI_API_KEY=

# Optional: real no-wallet payments on chain 44005 (server side only, never commit real keys).
# Operator: funds a capped live batch (needs about 2 tUSD8 and a little tQDAY for gas),
# pays the x402 transcript fee and relays the editor's signed answer.
SIKIO_OPERATOR_PRIVATE_KEY=
# Editor: only signs answers (EIP-712), needs no funds.
SIKIO_EDITOR_PRIVATE_KEY=
# Optional: the x402 agent that signs EIP-3009 payments. Leave empty to derive it from
# the operator key; the operator tops it up to a 0.40 tUSD8 float. It never needs gas.
SIKIO_AGENT_PRIVATE_KEY=

# Optional: live spending limits in tUSD8 (over a limit, payments are labelled sandbox).
# LIVE_VISITOR_HOURLY_TUSD8=1.00
# LIVE_DAILY_CAP_TUSD8=1.50
